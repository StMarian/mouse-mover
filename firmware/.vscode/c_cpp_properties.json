{
    "version": 4,
    "configurations": [
        {
            "name": "STM32F103 (arm-none-eabi)",
            "compileCommands": "${workspaceFolder}/build/Debug/compile_commands.json",
            "compilerPath": "/usr/bin/arm-none-eabi-gcc",
            "compilerArgs": ["-mcpu=cortex-m3", "-mthumb"],
            "cStandard": "c11",
            "intelliSenseMode": "linux-gcc-arm",
            "includePath": [
                "${workspaceFolder}/App/Inc",
                "${workspaceFolder}/App/Bsp/Inc",
                "${workspaceFolder}/App/Drivers/Inc",
                "${workspaceFolder}/Core/Inc",
                "${workspaceFolder}/Drivers/STM32F1xx_HAL_Driver/Inc",
                "${workspaceFolder}/Drivers/STM32F1xx_HAL_Driver/Inc/Legacy",
                "${workspaceFolder}/Drivers/CMSIS/Device/ST/STM32F1xx/Include",
                "${workspaceFolder}/Drivers/CMSIS/Include"
            ],
            "defines": ["USE_HAL_DRIVER", "STM32F103xB", "DEBUG"]
        },
        {
            "name": "Host tests (gcc)",
            "compileCommands": "${workspaceFolder}/build/tests/compile_commands.json",
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c11",
            "intelliSenseMode": "linux-gcc-x64",
            "includePath": [
                "${workspaceFolder}/test/fakes",
                "${workspaceFolder}/test/support",
                "${workspaceFolder}/App/Inc",
                "${workspaceFolder}/App/Drivers/Inc",
                "${workspaceFolder}/App/Bsp/Inc",
                "${workspaceFolder}/build/tests/_deps/unity-src/src"
            ]
        }
    ]
}
