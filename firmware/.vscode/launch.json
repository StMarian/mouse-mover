{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/mouse-mover.elf",
            "configFiles": ["${workspaceFolder}/openocd.cfg"],
            "searchDir": ["${workspaceFolder}"],
            "device": "STM32F103C8",
            "svdFile": "${workspaceFolder}/debug/STM32F103.svd",
            "runToEntryPoint": "main",
            "preLaunchTask": "build",
            "showDevDebugOutput": "none"
        },
        {
            "name": "Attach",
            "detail": "Inspect what is already running. Does not build, flash, or reset.",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/mouse-mover.elf",
            "configFiles": ["${workspaceFolder}/openocd.cfg"],
            "searchDir": ["${workspaceFolder}"],
            "device": "STM32F103C8",
            "svdFile": "${workspaceFolder}/debug/STM32F103.svd",
            "showDevDebugOutput": "none"
        }
    ]
}
